---
import Icon from './Icon.astro'
import { SITE, langHome, type Lang } from '../lib/site'
import { useDict } from '../i18n/ui'
import { business } from '../data/business'

// "Porosit tani" calls the restaurant (same action as the hero button).
const orderHref = business.telephone ? `tel:${business.telephone}` : '#kontakt'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useDict(lang)
const other: Lang = lang === 'sq' ? 'en' : 'sq'
const otherHome = langHome(other)

const nav = [
  { href: '#menuja', label: t.navMenu },
  { href: '#rreth-nesh', label: t.navAbout },
  { href: '#kontakt', label: t.navContact }
]
---

<header class="hd">
  <div class="container hd__inner">
    <a class="hd__brand" href={langHome(lang)} aria-label={SITE.brand}>
      <img
        src={SITE.logo}
        width="44"
        height="43"
        alt={SITE.brand}
        decoding="async"
      />
      <span class="hd__brandname">{SITE.brand}</span>
    </a>

    <nav class="hd__nav" aria-label={t.navMenu}>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <div class="hd__actions">
      <a class="hd__lang" href={otherHome} data-lang-switch aria-label={t.langSwitchAria}>
        {t.langButton}
      </a>
      <a class="btn btn--primary hd__order" href={orderHref}>{t.order}</a>
      <button
        type="button"
        class="hd__burger"
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-burger
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="hd__mobile" id="mobile-menu" data-mobile hidden>
    <nav class="hd__mobile-nav" aria-label={t.navMenu}>
      {nav.map((n) => <a href={n.href} data-close>{n.label}</a>)}
      <a class="hd__mobile-lang" href={otherHome} data-lang-switch>{t.langButton === 'EN' ? 'English' : 'Shqip'}</a>
      <a class="btn btn--primary" href={orderHref} data-close>{t.order}</a>
    </nav>
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .hd__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    height: var(--header-h);
  }
  .hd__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    flex: 0 0 auto;
  }
  .hd__brand img {
    width: 44px;
    height: auto;
  }
  .hd__brandname {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 18px;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .hd__nav {
    display: flex;
    gap: var(--sp-6);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .hd__nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
    padding: 6px 2px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .hd__nav a:hover {
    color: var(--brown);
    border-color: var(--brown);
  }
  .hd__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex: 0 0 auto;
  }
  .hd__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 40px;
    padding: 0 12px;
    border: 1.5px solid var(--border);
    border-radius: var(--r-pill);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--brown);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .hd__lang:hover {
    border-color: var(--brown);
    background: var(--cream-2);
  }
  .hd__burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .hd__mobile {
    display: none;
    border-top: 1px solid var(--border);
    background: var(--cream);
  }
  .hd__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-5) var(--sp-6);
  }
  .hd__mobile-nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 18px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--border);
  }
  .hd__mobile-nav .btn {
    margin-top: var(--sp-3);
  }
  .hd__mobile-lang {
    color: var(--brown);
  }

  @media (max-width: 860px) {
    .hd__nav,
    .hd__order,
    .hd__lang {
      display: none;
    }
    .hd__burger {
      display: inline-flex;
    }
    .hd__mobile.is-open {
      display: block;
    }
    .hd__brandname {
      font-size: 16px;
    }
  }
</style>

<script>
  // Mobile menu toggle + language links that preserve the current section hash.
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')
  const mobile = document.querySelector<HTMLElement>('[data-mobile]')

  function setOpen(open: boolean) {
    if (!burger || !mobile) return
    mobile.classList.toggle('is-open', open)
    mobile.hidden = !open
    burger.setAttribute('aria-expanded', String(open))
  }
  burger?.addEventListener('click', () => {
    setOpen(!mobile?.classList.contains('is-open'))
  })
  document.querySelectorAll('[data-close]').forEach((el) =>
    el.addEventListener('click', () => setOpen(false))
  )

  // Carry the hash across the language switch so the reader stays in place.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      if (location.hash) a.href = a.href.split('#')[0] + location.hash
    })
  })
</script>
