---
import { foods, foodDescription } from '../data/menu'
import { useDict } from '../i18n/ui'
import type { Lang } from '../lib/site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useDict(lang)
---

<section id="menuja" class="section menu" aria-labelledby="menu-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="menu-title" class="section-head__title">{t.menuTitle}</h2>
      <p class="section-head__sub">{t.menuSubtitle}</p>
    </div>

    <ul class="menu__grid">
      {
        foods.map((f) => (
          <li class="card reveal">
            <div class="card__media">
              <img
                src={f.image}
                width="297"
                height="198"
                loading="lazy"
                decoding="async"
                alt={f.name}
              />
              {f.popular && <span class="card__badge">{t.popular}</span>}
            </div>
            <div class="card__body">
              <div class="card__top">
                <h3 class="card__name">{f.name}</h3>
                <span class="card__price">
                  {f.price} <span class="card__cur">{f.currency}</span>
                </span>
              </div>
              <p class="card__desc">{foodDescription(f, lang)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .menu__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }
  .card__media {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--cream-2);
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--badge-soft);
    color: var(--brown);
    border: 1px solid var(--border);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }
  .card__body {
    padding: var(--sp-4) var(--sp-4) var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .card__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .card__name {
    font-family: var(--font-head);
    font-size: 20px;
    font-weight: 600;
  }
  .card__price {
    flex: 0 0 auto;
    background: var(--brown);
    color: var(--cream);
    font-weight: 700;
    font-size: 14px;
    padding: 6px 11px;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }
  .card__cur {
    font-size: 11px;
    opacity: 0.85;
  }
  .card__desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 15.5px;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .menu__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .menu__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
