---
import Icon from './Icon.astro'
import { useDict } from '../i18n/ui'
import type { Lang } from '../lib/site'
import { business, hasMap } from '../data/business'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useDict(lang)

// Address: city is confirmed (Tiranë); street is not — show the known part.
const addressValue = business.streetAddress
  ? `${business.streetAddress}, ${business.city ?? 'Tiranë'}`
  : business.city
    ? `${business.city}, ${lang === 'en' ? 'Albania' : 'Shqipëri'}`
    : null

// Local display of the phone, e.g. +355683701800 → 068 370 1800
const phoneDisplay = business.telephone
  ? business.telephone.replace(/^\+355/, '0').replace(/(\d{3})(\d{3})(\d{4})/, '$1 $2 $3')
  : null

const hasCoords = business.latitude != null && business.longitude != null
const mapSrc = hasCoords
  ? `https://www.google.com/maps?q=${business.latitude},${business.longitude}&z=16&hl=${lang}&output=embed`
  : null

type Card = {
  icon: 'pin' | 'clock' | 'phone'
  label: string
  value: string | null
  href?: string
  external?: boolean
}
const cards: Card[] = [
  {
    icon: 'pin',
    label: t.address,
    value: addressValue,
    href: hasMap ? business.googleMapsUrl! : undefined,
    external: true
  },
  {
    icon: 'clock',
    label: t.hours,
    value: business.openingHours ? business.openingHours.display[lang] : null
  },
  {
    icon: 'phone',
    label: t.phone,
    value: phoneDisplay,
    href: business.telephone ? `tel:${business.telephone}` : undefined
  }
]
---

<section id="kontakt" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="contact-title" class="section-head__title">{t.findHeading}</h2>
      <p class="section-head__sub">{t.findSub}</p>
    </div>

    <ul class="contact__cards reveal">
      {
        cards.map((c) => (
          <li class="contact__card">
            <span class="contact__cicon">
              <Icon name={c.icon} size={24} />
            </span>
            <h3 class="contact__clabel">{c.label}</h3>
            <span class="contact__dash" aria-hidden="true" />
            {c.value ? (
              c.href ? (
                <a
                  class="contact__cvalue contact__cvalue--link"
                  href={c.href}
                  {...(c.external
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {c.value}
                </a>
              ) : (
                <p class="contact__cvalue">{c.value}</p>
              )
            ) : (
              <p class="contact__cvalue contact__cvalue--todo">{t.toBeAddedLater}</p>
            )}
          </li>
        ))
      }
    </ul>

    {
      mapSrc && (
        <div class="contact__map reveal">
          <iframe
            class="contact__mapframe"
            src={mapSrc}
            title={t.mapTitle}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        </div>
      )
    }

    {
      hasMap && (
        <div class="contact__mapcta reveal">
          <a
            class="btn btn--primary"
            href={business.googleMapsUrl!}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.openInMaps}
            <Icon name="arrow" size={18} />
          </a>
        </div>
      )
    }

    <div class="contact__cta reveal">
      <h2 class="contact__cta-title">{t.contactCtaTitle}</h2>
      <p class="contact__cta-sub">{t.contactCtaSub}</p>
      {
        business.telephone && (
          <a class="btn btn--primary" href={`tel:${business.telephone}`}>
            <Icon name="phone" size={18} />
            {t.phoneCall}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact__cards {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 960px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }
  .contact__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--sp-5);
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .contact__cicon {
    color: var(--brown);
    margin-bottom: var(--sp-3);
  }
  .contact__clabel {
    font-family: var(--font-head);
    font-size: 21px;
    font-weight: 600;
    margin: 0 0 var(--sp-3);
  }
  .contact__dash {
    width: 26px;
    height: 2px;
    background: var(--brown);
    opacity: 0.5;
    border-radius: 2px;
    margin-bottom: var(--sp-3);
  }
  .contact__cvalue {
    margin: 0;
    color: var(--ink-soft);
    font-size: 16px;
  }
  .contact__cvalue--link {
    color: var(--brown);
    font-weight: 600;
    text-decoration: none;
  }
  .contact__cvalue--link:hover {
    text-decoration: underline;
  }
  .contact__cvalue--todo {
    font-style: italic;
    opacity: 0.85;
  }

  /* Map */
  .contact__map {
    max-width: 960px;
    margin: var(--sp-6) auto 0;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .contact__mapframe {
    display: block;
    width: 100%;
    height: 340px;
    border: 0;
  }
  .contact__mapcta {
    display: flex;
    justify-content: center;
    margin-top: var(--sp-5);
  }
  .contact__mapcta .btn {
    min-width: 280px;
  }

  /* Call-to-action */
  .contact__cta {
    max-width: 960px;
    margin: var(--sp-8) auto 0;
    padding-top: var(--sp-7);
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .contact__cta-title {
    font-size: clamp(24px, 5vw, 34px);
    margin-bottom: var(--sp-3);
  }
  .contact__cta-sub {
    color: var(--ink-soft);
    margin: 0 auto var(--sp-5);
    max-width: 46ch;
  }

  @media (max-width: 760px) {
    .contact__cards {
      grid-template-columns: 1fr;
    }
    .contact__mapframe {
      height: 300px;
    }
  }
</style>
